@inherits LayoutComponentBase
@using BarloPortfolio.Models
@inject IJSRuntime JS

<nav class="navbar">
    <div class="container">
        <a href="#top" class="brand">BO<span class="dot">.dev</span></a>

        <ul class="nav-links @(_menuOpen ? "open" : "")">
            <li><a href="#about" @onclick="CloseMenu">About</a></li>
            <li><a href="#skills" @onclick="CloseMenu">Skills</a></li>
            <li><a href="#projects" @onclick="CloseMenu">Projects</a></li>
            <li><a href="#experience" @onclick="CloseMenu">Experience</a></li>
            <li><a href="#contact" @onclick="CloseMenu">Contact</a></li>
        </ul>

        <div class="nav-right">
            <button class="theme-toggle" @onclick="ToggleTheme" aria-label="Toggle theme" title="Toggle theme">
                @if (_isDark)
                {
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" /></svg>
                }
                else
                {
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z" /></svg>
                }
            </button>
            <button class="nav-toggle" @onclick="ToggleMenu" aria-label="Toggle menu">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12h18M3 6h18M3 18h18" /></svg>
            </button>
        </div>
    </div>
</nav>

<div id="top">
    @Body
</div>

<footer>
    <div class="container">
        <div class="footer-social">
            <a href="@SocialLinks.GitHub" target="_blank" rel="noopener noreferrer" class="social-icon" aria-label="GitHub" title="GitHub">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.57.1.79-.25.79-.55 0-.27-.01-1.16-.02-2.11-3.2.7-3.88-1.36-3.88-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.04-.72.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.76 2.69 1.25 3.35.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.04 0 0 .97-.31 3.18 1.18a11.03 11.03 0 0 1 5.79 0c2.21-1.49 3.18-1.18 3.18-1.18.63 1.58.23 2.75.11 3.04.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.38-5.25 5.67.41.36.78 1.07.78 2.16 0 1.56-.01 2.82-.01 3.2 0 .3.21.66.8.55A10.52 10.52 0 0 0 23.5 12c0-6.35-5.15-11.5-11.5-11.5Z" /></svg>
            </a>
            <a href="@SocialLinks.Facebook" target="_blank" rel="noopener noreferrer" class="social-icon" aria-label="Facebook" title="Facebook">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5.02 3.66 9.18 8.44 9.94v-7.03H7.9v-2.91h2.54V9.85c0-2.51 1.49-3.9 3.77-3.9 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56v1.89h2.78l-.44 2.91h-2.34V22c4.78-.76 8.44-4.92 8.44-9.94Z" /></svg>
            </a>
            <a href="mailto:@SocialLinks.Email" class="social-icon" aria-label="Email" title="Email">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 6 12 13 2 6" /><path d="M2 6h20v12H2z" /></svg>
            </a>
        </div>
        &copy; @DateTime.Now.Year Barlo Ordiales. Built with Blazor &amp; C#.
    </div>
</footer>

<button class="back-to-top @(_showBackToTop ? "visible" : "")" @onclick="ScrollToTop" aria-label="Back to top">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 19V5M5 12l7-7 7 7" /></svg>
</button>

@code {
    private bool _isDark = true;
    private bool _menuOpen;
    private bool _showBackToTop;
    private DotNetObjectReference<MainLayout>? _selfRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var theme = await JS.InvokeAsync<string>("portfolioSite.getTheme");
            _isDark = theme != "light";
            _selfRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("portfolioSite.registerScrollWatcher", _selfRef);
        }
    }

    [JSInvokable]
    public void OnScroll(double scrollY)
    {
        var shouldShow = scrollY > 400;
        if (shouldShow != _showBackToTop)
        {
            _showBackToTop = shouldShow;
            StateHasChanged();
        }
    }

    private async Task ToggleTheme()
    {
        _isDark = !_isDark;
        await JS.InvokeVoidAsync("portfolioSite.setTheme", _isDark ? "dark" : "light");
    }

    private void ToggleMenu() => _menuOpen = !_menuOpen;

    private void CloseMenu() => _menuOpen = false;

    private async Task ScrollToTop()
    {
        await JS.InvokeVoidAsync("window.scrollTo", new { top = 0, behavior = "smooth" });
    }
}
