    private readonly string[] _filters = { "All Projects", "Featured", ".NET", "SQL" };
    private string _activeFilter = "All Projects";

    private IEnumerable<Project> FilteredProjects => _activeFilter switch
    {
        "Featured" => _projects.Where(p => p.Featured),
        ".NET" => _projects.Where(p => p.Tags.Contains(".NET")),
        "SQL" => _projects.Where(p => p.Tags.Contains("SQL")),
